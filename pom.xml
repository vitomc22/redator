<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.redator</groupId>
    <artifactId>corretor-enem</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>corretor-enem</name>
    <description>MVP do corretor automatizado de redações ENEM</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.outputTimestamp>2026-10-19T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.12.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.4</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>5.5.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <app.data-directory>${project.build.directory}/test-data</app.data-directory>
                        <!-- Legacy compatibility suite; profile integration and browser tests cover the default routing. -->
                        <app.profile-databases>false</app.profile-databases>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>2.9.1</version>
                <executions>
                    <execution>
                        <phase>generate-resources</phase>
                        <goals><goal>makeAggregateBom</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <schemaVersion>1.6</schemaVersion>
                    <includeBomSerialNumber>false</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeTestScope>false</includeTestScope>
                    <outputReactorProjects>false</outputReactorProjects>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release-quality</id>
            <properties>
                <rag.release.benchmark>${project.basedir}/eval/frozen/public-test-v1.json</rag.release.benchmark>
                <rag.release.baseline>${project.basedir}/eval/results/baseline-v1.json</rag.release.baseline>
                <rag.release.candidate>${project.basedir}/eval/results/rag-v1.json</rag.release.candidate>
                <rag.release.policy>lexical-v1</rag.release.policy>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>require-real-rag-quality</id>
                                <phase>prepare-package</phase>
                                <goals><goal>java</goal></goals>
                                <configuration>
                                    <mainClass>com.redator.corretor.cli.RagQualityGateCli</mainClass>
                                    <classpathScope>runtime</classpathScope>
                                    <arguments>
                                        <argument>--release</argument>
                                        <argument>${rag.release.policy}</argument>
                                        <argument>${rag.release.benchmark}</argument>
                                        <argument>${rag.release.baseline}</argument>
                                        <argument>${rag.release.candidate}</argument>
                                        <argument>${project.build.directory}/rag-release-gate.json</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>dev-local</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>start-and-verify-ollama</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/ollama-prerequisites.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <environmentVariables>
                                <LLM_PROVIDER>ollama</LLM_PROVIDER>
                                <OLLAMA_BASE_URL>http://127.0.0.1:11434</OLLAMA_BASE_URL>
                                <OLLAMA_MODEL>gemma4:e2b-it-q4_K_M</OLLAMA_MODEL>
                                <OLLAMA_NUM_CTX>8192</OLLAMA_NUM_CTX>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
